{
	"name": "@magic-spells/split-text",
	"version": "0.1.1",
	"description": "Lightweight text-reveal web component — slide-up animation by word, character, or line with no dependencies",
	"author": "Cory Schulz",
	"license": "MIT",
	"type": "module",
	"main": "dist/split-text.esm.js",
	"module": "dist/split-text.esm.js",
	"unpkg": "dist/split-text.min.js",
	"style": "dist/split-text.min.css",
	"exports": {
		".": {
			"import": "./dist/split-text.esm.js",
			"default": "./dist/split-text.esm.js"
		},
		"./css": "./dist/split-text.css",
		"./css/min": "./dist/split-text.min.css"
	},
	"sideEffects": true,
	"repository": {
		"type": "git",
		"url": "https://github.com/magic-spells/split-text"
	},
	"homepage": "https://github.com/magic-spells/split-text#readme",
	"bugs": {
		"url": "https://github.com/magic-spells/split-text/issues"
	},
	"keywords": [
		"split-text",
		"text-animation",
		"text-reveal",
		"slide-up",
		"web-components",
		"custom-elements",
		"intersection-observer",
		"accessibility"
	],
	"files": [
		"dist/",
		"src/"
	],
	"scripts": {
		"build": "NODE_ENV=production node scripts/build.mjs",
		"dev": "NODE_ENV=development node scripts/build.mjs",
		"lint": "eslint src/ scripts/",
		"format": "prettier --write .",
		"prepublishOnly": "npm run build"
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"browserslist": [
		"last 2 versions",
		"not dead",
		"not ie <= 11"
	],
	"devDependencies": {
		"@eslint/js": "^9.38.0",
		"@magic-spells/vite-plugin-live-reload": "^0.1.0",
		"eslint": "^9.38.0",
		"globals": "^15.15.0",
		"lightningcss": "^1.29.3",
		"prettier": "^3.3.3",
		"terser": "^5.16.0",
		"vite": "^8.0.10"
	}
}
